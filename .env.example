# GitHub fine-grained PAT with read-only Discussions access.
# Powers the converge/diverge reaction feature (/api/ensemble).
# Contributors do NOT need this for writing or previewing posts.
GITHUB_TOKEN=

# ── Page view counter (optional, Upstash Redis) ──
# If not configured, views display as blank (no error).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Blog submission form (Resend) ──
# Sends form submissions to the site owner via email.
# Sign up at resend.com, copy the API key.
# Free tier: 100 emails/day, no expiry.
RESEND_API_KEY=
SUBMIT_TO_EMAIL=

# ── Newsletter + subscribe form (Resend Broadcasts/Contacts) ──
# Powers scripts/send-newsletter.mjs AND the /api/subscribe endpoint.
# Setup + usage: docs/email-notifications.md
# Needs a FULL-ACCESS Resend key (contacts + broadcasts), separate from the
# send-only RESEND_API_KEY above. NEWSLETTER_FROM must use a verified domain.
# IMPORTANT: RESEND_FULL_API_KEY + RESEND_AUDIENCE_ID must also be set in Vercel
# (Project → Settings → Environment Variables) for /api/subscribe to work in prod.
RESEND_FULL_API_KEY=
NEWSLETTER_FROM=The Ensemble Edit <hello@your-verified-domain>
NEWSLETTER_REPLY_TO=you@your-real-inbox
SITE_URL=https://the-ensemble-edit.com
RESEND_AUDIENCE_ID=
