---
/**
 * Pixel-art parallax hero with 4 layers + optional avatar characters.
 *
 * Layer classification:
 *   1.png = sky gradient   (back, no drift)
 *   2.png = clouds         (drifts RIGHT, slow)
 *   3.png = distant land   (LAND-FAR  — drifts LEFT, opposite clouds)
 *   avatars = characters   (drift with foreground layer 4, on top of trees)
 *   4.png = close trees    (TREES     — drifts LEFT, same as land, -120px offset)
 *
 * Direction rules:
 *   clouds  → RIGHT (+576px)
 *   land    → LEFT  (-576px)  — opposite to clouds
 *   trees   → LEFT  (-576px)  — same as land, offset -120px
 *
 * Zoom: .parallax-scene scaled 1.1× from top-center.
 * Reduced motion: drift stopped, zoom preserved.
 */

type Avatar = { id: string; avatar: string; name: string }
type Props = { avatars?: Avatar[] }
const { avatars = [] } = Astro.props

// Per-author bottom offset (% from bottom) to place each avatar on the grass.
// Hafssa is higher so her full body is visible above the grass line.
const AVATAR_BOTTOM: Record<string, number> = {
	hafssa: 11,
	lainey: 10,
	oisin: 12,
}
const DEFAULT_BOTTOM = 10

// How many tile widths one group of avatars spans. With SPREAD=2 and
// tileWidth ≈ 1067px, avatars are ≈ 711px apart (3 authors) — duplicates
// sit 2× tileWidth ≈ 2134px away, well outside any viewport. Scales
// naturally as more authors join: 6 authors → ≈ 356px spacing, still fine.
const SPREAD = 2
---

<div class="parallax-hero relative w-full min-h-[max(52vh,420px)] sm:min-h-[max(48vh,440px)] lg:min-h-[max(50vh,480px)]" style="overflow: clip;">
	<!-- Sky wrapper (furthest back) -->
	<div class="parallax-scene absolute inset-0">
		<div
			class="parallax-layer absolute inset-0"
			data-layer="1"
			data-speed="0"
			style="background: url('/parallax/1.png') repeat-x center calc(100% + 35px) / auto 120%;"
		></div>
	</div>

	<!-- Sun / Moon — sits between sky and overlay -->
	<div class="absolute top-[122px] right-[140px] sm:right-[158px]" style="z-index: 5; pointer-events: none;">
		<img
			src="/icons/ui/sun-hero.png"
			alt=""
			class="celestial-sun h-14 sm:h-16 w-auto"
			style="image-rendering: pixelated;"
		/>
		<img
			src="/icons/ui/moon-hero.png"
			alt=""
			class="celestial-moon absolute inset-0 h-14 sm:h-16 w-auto"
			style="image-rendering: pixelated;"
		/>
	</div>

	<!-- Dark overlay for text readability -->
	<div class="absolute inset-0 bg-black/30 dark:bg-black/50" style="z-index: 6;"></div>

	<!-- Stars — above the dark overlay so they're clearly visible -->
	<div class="absolute inset-0" style="z-index: 7; pointer-events: none;">
		{/* Small stars (3px) */}
		<span class="hero-star" style="top: 8%; left: 12%; width: 3px; height: 3px; opacity: 0.7; background: #fff5e0;"></span>
		<span class="hero-star" style="top: 15%; left: 38%; width: 3px; height: 3px; opacity: 0.6; background: #fffdf5;"></span>
		<span class="hero-star" style="top: 22%; left: 72%; width: 3px; height: 3px; opacity: 0.75; background: #ffeebb;"></span>
		<span class="hero-star" style="top: 5%; left: 55%; width: 3px; height: 3px; opacity: 0.6; background: #fff8e7;"></span>
		<span class="hero-star" style="top: 30%; left: 25%; width: 3px; height: 3px; opacity: 0.65; background: #fff5d0;"></span>
		<span class="hero-star" style="top: 12%; left: 85%; width: 3px; height: 3px; opacity: 0.7; background: #fffcf0;"></span>
		<span class="hero-star" style="top: 35%; left: 60%; width: 3px; height: 3px; opacity: 0.55; background: #ffeebb;"></span>
		<span class="hero-star" style="top: 18%; left: 5%; width: 3px; height: 3px; opacity: 0.7; background: #fff5e0;"></span>
		<span class="hero-star" style="top: 42%; left: 45%; width: 3px; height: 3px; opacity: 0.6; background: #fffdf5;"></span>
		<span class="hero-star" style="top: 8%; left: 30%; width: 3px; height: 3px; opacity: 0.65; background: #fff8e7;"></span>
		<span class="hero-star" style="top: 25%; left: 92%; width: 3px; height: 3px; opacity: 0.7; background: #ffeebb;"></span>
		<span class="hero-star" style="top: 48%; left: 78%; width: 3px; height: 3px; opacity: 0.55; background: #fff5d0;"></span>
		<span class="hero-star" style="top: 38%; left: 8%; width: 3px; height: 3px; opacity: 0.65; background: #fffcf0;"></span>
		<span class="hero-star" style="top: 3%; left: 68%; width: 3px; height: 3px; opacity: 0.75; background: #fff5e0;"></span>
		<span class="hero-star" style="top: 50%; left: 18%; width: 3px; height: 3px; opacity: 0.55; background: #fff8e7;"></span>
		{/* Medium stars (4px) with soft glow */}
		<span class="hero-star hero-star-glow" style="top: 10%; left: 48%; width: 4px; height: 4px; opacity: 0.9; background: #ffe8a0;"></span>
		<span class="hero-star hero-star-glow" style="top: 28%; left: 15%; width: 4px; height: 4px; opacity: 0.8; background: #fff0c0;"></span>
		<span class="hero-star hero-star-glow" style="top: 6%; left: 80%; width: 4px; height: 4px; opacity: 0.85; background: #ffeebb;"></span>
		<span class="hero-star hero-star-glow" style="top: 20%; left: 58%; width: 4px; height: 4px; opacity: 0.8; background: #fff5d0;"></span>
		<span class="hero-star hero-star-glow" style="top: 40%; left: 35%; width: 4px; height: 4px; opacity: 0.75; background: #ffe8a0;"></span>
		<span class="hero-star hero-star-glow" style="top: 14%; left: 93%; width: 4px; height: 4px; opacity: 0.85; background: #fff0c0;"></span>
		<span class="hero-star hero-star-glow" style="top: 45%; left: 52%; width: 4px; height: 4px; opacity: 0.8; background: #ffeebb;"></span>
		{/* Lower sky fill */}
		<span class="hero-star" style="top: 55%; left: 32%; width: 3px; height: 3px; opacity: 0.65; background: #fff5e0;"></span>
		<span class="hero-star" style="top: 52%; left: 70%; width: 3px; height: 3px; opacity: 0.6; background: #fffdf5;"></span>
		<span class="hero-star" style="top: 58%; left: 12%; width: 3px; height: 3px; opacity: 0.7; background: #ffeebb;"></span>
		<span class="hero-star" style="top: 46%; left: 88%; width: 3px; height: 3px; opacity: 0.6; background: #fff8e7;"></span>
		<span class="hero-star" style="top: 54%; left: 50%; width: 3px; height: 3px; opacity: 0.55; background: #fff5d0;"></span>
		<span class="hero-star hero-star-glow" style="top: 56%; left: 82%; width: 4px; height: 4px; opacity: 0.8; background: #ffe8a0;"></span>
		<span class="hero-star" style="top: 60%; left: 40%; width: 3px; height: 3px; opacity: 0.6; background: #fffcf0;"></span>
		<span class="hero-star" style="top: 50%; left: 5%; width: 3px; height: 3px; opacity: 0.65; background: #fff5e0;"></span>
		{/* Bright stars (5–6px) — cross shape with glow */}
		<span class="hero-star hero-star-cross" style="top: 4%; left: 22%; width: 5px; height: 5px; opacity: 1; background: #ffe8a0;"></span>
		<span class="hero-star hero-star-cross" style="top: 16%; left: 65%; width: 5px; height: 5px; opacity: 0.95; background: #fff0c0;"></span>
		<span class="hero-star hero-star-cross" style="top: 32%; left: 88%; width: 6px; height: 6px; opacity: 1; background: #ffd770;"></span>
	</div>

	<!-- Top-edge gradient for nav blending -->
	<div class="absolute inset-x-0 top-0 h-28 bg-gradient-to-b from-black/30 to-transparent" style="z-index: 7;"></div>

	<!-- Content slot — z-index: 8. Absolute so the hero's height comes from
	     min-height alone, keeping text position proportional at any viewport. -->
	<div class="absolute inset-0" style="z-index: 8;">
		<slot />
	</div>

	<!-- Cloud overlay: above nav (z-40) and title (z-8), clicks pass through.
	     Below sm the drift JS is off, so a cloud would sit frozen over the
	     title — keep clouds behind the text there. -->
	<div class="parallax-scene absolute inset-0 pointer-events-none z-[7] sm:z-50">
		<div
			class="parallax-layer absolute inset-0"
			data-layer="2"
			data-speed="0.015"
			data-drift-dur="240"
			data-drift-dir="1"
			data-drift-x="500"
			style="background: url('/parallax/2.png') repeat-x 500px calc(100% + 130px) / auto 120%;"
		></div>
	</div>

	<!-- Ground overlay: above cloud (z-55), clicks pass through -->
	<div class="parallax-scene absolute inset-0" style="z-index: 55; pointer-events: none;">
		<div
			class="parallax-layer absolute inset-0"
			data-layer="3"
			data-speed="0.03"
			data-drift-dur="130"
			data-drift-dir="-1"
			data-drift-x="0"
			style="background: url('/parallax/3.png') repeat-x center calc(100% + 65px) / auto 120%;"
		></div>

		<div
			class="parallax-layer absolute inset-0"
			data-layer="4"
			data-speed="0.05"
			data-drift-dur="60"
			data-drift-dir="-1"
			data-drift-x="-220"
			style="background: url('/parallax/4.png') repeat-x -220px calc(100% + 30px) / auto 120%;"
		></div>

		{/* Avatars — on top of the foreground grass (layer 4), drifting at the same rate.
		     Two identical groups rendered across SPREAD×2 tile widths for seamless
		     wrapping. Duplicates are SPREAD tile widths apart (> viewport), so each
		     avatar only appears once on screen at any given time. */}
		{avatars.length > 0 && (
			<div
				class="hero-avatars absolute bottom-0 left-0 h-full"
				data-drift-dur="60"
				data-drift-dir="-1"
				data-spread={SPREAD}
				style="pointer-events: none;"
			>
				{[0, 1].map((copy) =>
					avatars.map((a, i) => (
						<a
							href={`/authors/${a.id}/`}
							class="hero-avatar absolute"
							style={`bottom: ${AVATAR_BOTTOM[a.id] ?? DEFAULT_BOTTOM}%; left: ${((copy * avatars.length + i) / (avatars.length * 2)) * 100}%; pointer-events: auto;`}
						>
							<img
								src={a.avatar}
								alt={a.name}
								class="h-10 sm:h-12 w-auto pixel-hop"
								style="image-rendering: pixelated;"
							/>
						</a>
					))
				)}
			</div>
		)}
	</div>
</div>

<style>
	/* Subtle zoom to reduce visible tiling. Scale from top-center
	   so cloud peaks keep breathing room. */
	.parallax-scene {
		transform: scale(1.1);
		transform-origin: center top;
		will-change: transform;
	}

	/* Pixel art must stay crisp */
	.parallax-layer {
		image-rendering: pixelated;
		image-rendering: -moz-crisp-edges;
		will-change: transform;
	}

	/* Sun / Moon slide transition — use transform (not Tailwind translate)
	   so the transition property fires correctly. */
	.celestial-sun,
	.celestial-moon {
		transition: transform 0.8s cubic-bezier(0.85, 0, 0.15, 1);
	}

	/* Light mode: sun visible, moon hidden below ground */
	.celestial-sun  { transform: translateY(0); }
	.celestial-moon { transform: translateY(120vh) scaleX(-1); }

	/* Dark mode: sun hidden below ground, moon visible (same height as sun) */
	:global(.dark) .celestial-sun  { transform: translateY(120vh); }
	:global(.dark) .celestial-moon { transform: translateY(0) scaleX(-1); }

	/* Stars — hidden below viewport in light mode, slide up with moon */
	.hero-star {
		position: absolute;
		background: white;
		transition: transform 0.8s cubic-bezier(0.85, 0, 0.15, 1);
		transform: translateY(120vh);
	}
	:global(.dark) .hero-star {
		transform: translateY(0);
	}

	/* Medium stars — soft warm glow */
	.hero-star-glow {
		box-shadow: 0 0 4px 1px rgba(255, 235, 160, 0.5);
	}

	/* Bright cross-shaped stars — arms + stronger glow */
	.hero-star-cross {
		box-shadow:
			0 -3px 0 -1px rgba(255, 240, 180, 0.7),
			0 3px 0 -1px rgba(255, 240, 180, 0.7),
			-3px 0 0 -1px rgba(255, 240, 180, 0.7),
			3px 0 0 -1px rgba(255, 240, 180, 0.7),
			0 0 8px 2px rgba(255, 230, 140, 0.6);
	}

	/* Reduced motion: JS skips drift + scroll; keep zoom */
	@media (prefers-reduced-motion: reduce) {
		.parallax-layer {
			will-change: auto;
		}
		.celestial-sun,
		.celestial-moon,
		.hero-star {
			transition: none;
		}
	}
</style>

<script>
	function initParallax() {
		const hero = document.querySelector('.parallax-hero') as HTMLElement | null
		if (!hero) return

		const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches
		const isMobile = window.innerWidth < 640
		if (prefersReduced || isMobile) return

		const layers = hero.querySelectorAll<HTMLElement>('.parallax-layer[data-speed]')
		const driftLayers = hero.querySelectorAll<HTMLElement>('.parallax-layer[data-drift-dur]')
		const avatarContainer = hero.querySelector<HTMLElement>('.hero-avatars')

		// Native tile aspect ratio (576×324), scaled 120% via background-size
		const BG_SCALE = 1.2
		const TILE_RATIO = 576 / 324
		const startTime = performance.now()
		let rafId = 0

		function frame(now: number) {
			const rect = hero!.getBoundingClientRect()
			const heroHeight = rect.height
			const heroTop = rect.top

			// Vertical scroll parallax
			const progress = Math.max(0, Math.min(1,
				(window.innerHeight - heroTop) / (window.innerHeight + heroHeight)
			))
			const scrollOffset = (progress - 0.5)

			layers.forEach((layer) => {
				const speed = parseFloat(layer.dataset.speed || '0')
				const y = scrollOffset * speed * heroHeight
				layer.style.transform = `translate3d(0, ${y}px, 0)`
			})

			// Horizontal drift using actual rendered tile width
			const elapsed = (now - startTime) / 1000

			const tileWidth = heroHeight * BG_SCALE * TILE_RATIO

			driftLayers.forEach((layer) => {
				const dur = parseFloat(layer.dataset.driftDur!)
				const dir = parseFloat(layer.dataset.driftDir!)
				const x0 = parseFloat(layer.dataset.driftX!)
				const drift = ((elapsed / dur) % 1) * tileWidth * dir
				layer.style.backgroundPositionX = `${x0 + drift}px`
			})

			// Drift avatars with layer 4 (foreground). Container = SPREAD×2 tile
			// widths (two identical groups). Wraps every SPREAD tiles so the
			// second group seamlessly replaces the first.
			if (avatarContainer) {
				const dur = parseFloat(avatarContainer.dataset.driftDur!)
				const dir = parseFloat(avatarContainer.dataset.driftDir!)
				const spread = parseInt(avatarContainer.dataset.spread || '2')
				const groupWidth = tileWidth * spread
				avatarContainer.style.width = `${groupWidth * 2}px`
				// Same px/s as layer 4, but cycle length = dur × spread
				const drift = ((elapsed / (dur * spread)) % 1) * groupWidth * dir
				avatarContainer.style.transform = `translate3d(${drift}px, 0, 0)`
			}

			rafId = requestAnimationFrame(frame)
		}

		rafId = requestAnimationFrame(frame)

		// Cleanup on page swap (Astro SPA)
		document.addEventListener('astro:before-swap', () => cancelAnimationFrame(rafId), { once: true })
	}

	initParallax()
	document.addEventListener('astro:after-swap', initParallax)
</script>
