---
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'
import { getEntry } from 'astro:content'
import { TRACKS } from '../consts'

const { post } = Astro.props

const blogImages = import.meta.glob<{ default: ImageMetadata }>(
	'/src/assets/blogimages/**/*.{jpeg,jpg,png,gif}'
)

const coverImagePath = blogImages[
	`/src/assets/blogimages/${post.slug}/cover.jpg`
]
	? `/src/assets/blogimages/${post.slug}/cover.jpg`
	: `/src/assets/blogimages/${post.slug}/cover.png`

const authors = await Promise.all(
	(post.data.authors || []).map((id: string) => getEntry('authors', id))
)
const resolvedAuthors = authors.filter(Boolean)
const authorNames = resolvedAuthors.map((a) => a.data.name).join(', ')

const trackLabel = TRACKS.find((t) => t.slug === post.data.track)?.label
---

<a
	href={`/blog/${post.slug}/`}
	class="grid grid-cols-1 group relative overflow-hidden rounded-xl"
>
	{
		blogImages[coverImagePath] ? (
			<Image
				src={blogImages[coverImagePath]()}
				alt={post.data.title}
				class="absolute inset-0 w-full h-full object-cover object-center transition-transform duration-300 group-hover:scale-[1.02]"
			/>
		) : (
			<div class="absolute inset-0 bg-foreground/10 dark:bg-foreground-dark/10" />
		)
	}
	<div
		class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/40 to-black/10 transition-opacity duration-300 group-hover:opacity-0"
	>
	</div>
	{
		post.data.description && (
			<div class="absolute inset-0 bg-black/80 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center p-8">
				<p class="text-white text-[20px] sm:text-[24px] font-sans leading-relaxed text-center">
					{post.data.description.trim()}
				</p>
			</div>
		)
	}
	<!-- Sets the card's minimum shape; the card grows taller when the text needs it -->
	<div class="col-start-1 row-start-1 w-full aspect-[4/3] sm:aspect-[5/2]"></div>
	<div
		class="relative col-start-1 row-start-1 self-end px-7 pb-7 pt-5 sm:px-10 sm:pb-10 sm:pt-6 text-white transition-opacity duration-300 group-hover:opacity-0"
	>
		<h3
			class="font-display text-[18px] sm:text-[22px] lg:text-[28px] xl:text-[32px] font-normal leading-[1.25] mb-3"
		>
			{post.data.title}
		</h3>
		<div class="flex items-center gap-3">
			{
				trackLabel && (
					<span class="font-meta text-[12px] uppercase tracking-[0.15em] text-white/70 font-medium">
						{trackLabel}
					</span>
				)
			}
			{trackLabel && <span class="text-white/40 text-[12px]">·</span>}
			<p
				class="font-meta text-[12px] text-white/70 font-medium tracking-[0.15em] uppercase"
			>
				By {authorNames || 'Staff'}
			</p>
		</div>
	</div>
</a>
