---
import { Icon } from 'astro-icon/components'
const { class: className } = Astro.props
---

<div
	class:list={[
		className,
		'flex justify-center items-center gap-0.5 text-foreground/40 dark:text-foreground-dark/50 [&>*]:cursor-pointer',
	]}
>
	<button
		data-theme="theme-auto"
		aria-label="Auto Theme"
		title="Set theme to follow system preference"
		class="theme-button theme-auto"
	>
		<Icon
			name="mdi:brightness-auto"
			class:list="duration-0 text-[17px]"
			aria-hidden
		/>
	</button>
	<button
		data-theme="theme-light"
		aria-label="Light Theme"
		title="Set theme to light"
		class="theme-button theme-light"
	>
		<Icon
			name="mdi:white-balance-sunny"
			class:list="duration-0 text-[17px]"
			aria-hidden
		/>
	</button>
	<button
		data-theme="theme-dark"
		aria-label="Dark Theme"
		title="Set theme to dark"
		class="theme-button theme-dark"
	>
		<Icon
			name="mdi:moon-and-stars"
			class:list="duration-0 text-[17px]"
			aria-hidden
		/>
	</button>
</div>

<style>
	@reference "../styles/global.css";

	button.theme-button {
		@apply p-[5px] rounded-md duration-0 transition-colors;
	}
	button.theme-button:hover {
		@apply text-foreground/80 dark:text-foreground-dark/80;
	}
	:global(button.active) {
		@apply text-primary dark:text-primary-dark;
	}
</style>
