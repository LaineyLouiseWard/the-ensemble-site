---
/**
 * Pixel-art corkboard — sits between Featured and Latest on the homepage.
 * Cork texture tiles as a repeating background; frame is pure CSS.
 * Notes are absolutely positioned with pins on top.
 */
---

<section class="app-container pt-16">
	<h2
		class="font-meta text-xs uppercase tracking-[0.2em] text-foreground/70 dark:text-foreground-dark/70 font-medium mb-4"
	>
		Pinboard
	</h2>

	<!-- Outer frame (light wood edge) -->
	<div class="corkboard-frame">
		<!-- Inner frame (dark wood edge) -->
		<div class="corkboard-frame-inner">
			<!-- Cork surface -->
			<div class="corkboard-surface">

				<!-- Note 1 -->
				<div class="cork-note" style="top: 20px; left: 5%;">
					<img src="/icons/pinboard/pin_red.png" alt="" class="cork-pin" />
					<img src="/icons/pinboard/note_plain_cream.png" alt="" class="cork-note-bg" />
					<span class="cork-note-text">UCDThesis template is amazing!</span>
				</div>

				<!-- Note 2 -->
				<div class="cork-note" style="top: 40px; left: 28%;">
					<img src="/icons/pinboard/pin_yellow.png" alt="" class="cork-pin" />
					<img src="/icons/pinboard/note_plain_rose.png" alt="" class="cork-note-bg" />
					<span class="cork-note-text">Coffee morning Tues 11am</span>
				</div>

				<!-- Note 3 -->
				<div class="cork-note" style="top: 15px; left: 52%;">
					<img src="/icons/pinboard/pin_red.png" alt="" class="cork-pin" />
					<img src="/icons/pinboard/note_plain_sage.png" alt="" class="cork-note-bg" />
					<span class="cork-note-text">Check out the submission portal!</span>
				</div>

				<!-- Note 4 -->
				<div class="cork-note" style="top: 50px; left: 75%;">
					<img src="/icons/pinboard/pin_black.png" alt="" class="cork-pin" />
					<img src="/icons/pinboard/note_torn_cream.png" alt="" class="cork-note-bg" />
					<span class="cork-note-text">Anyone have notes from the EPA workshop?</span>
				</div>

				<!-- Note 5 (second row) -->
				<div class="cork-note" style="top: 155px; left: 12%;">
					<img src="/icons/pinboard/pin_yellow.png" alt="" class="cork-pin" />
					<img src="/icons/pinboard/note_ringbinder_denim.png" alt="" class="cork-note-bg" />
					<span class="cork-note-text">EMS 2026 abstracts due soon</span>
				</div>

				<!-- Note 6 (second row) -->
				<div class="cork-note" style="top: 150px; left: 42%;">
					<img src="/icons/pinboard/pin_red.png" alt="" class="cork-pin" />
					<img src="/icons/pinboard/note_ruled_ochre.png" alt="" class="cork-note-bg" />
					<span class="cork-note-text">New post ideas welcome!</span>
				</div>

				<!-- Note 7 (second row) -->
				<div class="cork-note" style="top: 160px; left: 68%;">
					<img src="/icons/pinboard/pin_black.png" alt="" class="cork-pin" />
					<img src="/icons/pinboard/note_plain_rose.png" alt="" class="cork-note-bg" />
					<span class="cork-note-text">PhD presentation tips in the blog</span>
				</div>

			</div>
		</div>
	</div>
</section>

<style>
	/* Outer frame — lighter wood tone */
	.corkboard-frame {
		background: #8B6914;
		border-radius: 4px;
		padding: 6px;
		box-shadow:
			0 4px 16px rgba(0, 0, 0, 0.25),
			0 2px 4px rgba(0, 0, 0, 0.15);
	}

	/* Inner frame — darker wood tone, gives the two-tone border look */
	.corkboard-frame-inner {
		background: #6B4F12;
		border-radius: 2px;
		padding: 4px;
	}

	/* Cork surface — tiled texture */
	.corkboard-surface {
		background-image: url('/textures/corkboard.png');
		background-repeat: repeat;
		background-size: 256px 256px;
		image-rendering: pixelated;
		image-rendering: -moz-crisp-edges;
		min-height: 280px;
		border-radius: 1px;
		position: relative;
		padding: 1.5rem;
		box-shadow: inset 0 2px 8px rgba(0, 0, 0, 0.15);
		overflow: hidden;
	}

	@media (min-width: 768px) {
		.corkboard-surface {
			min-height: 340px;
		}
	}

	/* Individual note wrapper */
	.cork-note {
		position: absolute;
		width: 96px;
		height: 96px;
		transition: transform 0.2s ease, z-index 0s;
		cursor: default;
	}

	.cork-note:hover {
		transform: scale(2.2);
		z-index: 20;
	}

	/* Note background sprite */
	.cork-note-bg {
		width: 96px;
		height: 96px;
		image-rendering: pixelated;
		image-rendering: -moz-crisp-edges;
		display: block;
		pointer-events: none;
	}

	/* Opaque overlay on hover — covers note pattern so text is readable */
	.cork-note::after {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		background: rgba(255, 255, 250, 0.85);
		opacity: 0;
		transition: opacity 0.2s ease;
		pointer-events: none;
		z-index: 1;
	}

	.cork-note:hover::after {
		opacity: 1;
	}

	/* Pin sprite — centred on top of note */
	.cork-pin {
		width: 24px;
		height: 24px;
		image-rendering: pixelated;
		image-rendering: -moz-crisp-edges;
		position: absolute;
		top: -10px;
		left: 50%;
		transform: translateX(-50%);
		z-index: 3;
		pointer-events: none;
	}

	/* Text on the note — hidden until hover */
	.cork-note-text {
		position: absolute;
		top: 18px;
		left: 14px;
		right: 14px;
		bottom: 14px;
		font-size: 9px;
		line-height: 1.35;
		color: #3a3024;
		font-family: var(--font-meta);
		overflow: hidden;
		pointer-events: none;
		opacity: 0;
		transition: opacity 0.2s ease;
		z-index: 2;
	}

	.cork-note:hover .cork-note-text {
		opacity: 1;
	}
</style>
