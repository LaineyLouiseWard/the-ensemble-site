---
/**
 * Pixel-art corkboard — sits between Featured and Latest on the homepage.
 * Cork texture tiles as a repeating background; frame is pure CSS.
 *
 * Note types:
 *   - "plain" notes: show abbreviated title at rest, full text on hover
 *   - "patterned" notes (torn, ruled, ringbinder, etc.): pattern visible at rest,
 *     opaque overlay + text on hover
 */
---

<section class="app-container pt-16">
	<h2
		class="font-meta text-xs uppercase tracking-[0.2em] text-foreground/70 dark:text-foreground-dark/70 font-medium mb-4"
	>
		Pinboard
	</h2>

	<!-- Outer frame (light wood edge) -->
	<div class="corkboard-frame">
		<!-- Inner frame (dark wood edge) -->
		<div class="corkboard-frame-inner">
			<!-- Cork surface -->
			<div class="corkboard-surface">

				<!-- Note 1: plain, tilted left, normal size -->
				<div class="cork-note cork-note--plain" style="top: 18px; left: 4%; transform: rotate(-3deg);">
					<img src="/icons/pinboard/pin_red.png" alt="" class="cork-pin" />
					<img src="/icons/pinboard/note_plain_cream.png" alt="" class="cork-note-bg" />
					<span class="cork-note-title">Thesis template</span>
					<span class="cork-note-text">UCDThesis template is amazing! Check Boris's post for the link.</span>
				</div>

				<!-- Note 2: plain, tilted right, overlaps note 1 slightly -->
				<div class="cork-note cork-note--plain" style="top: 35px; left: 22%; transform: rotate(2.5deg);">
					<img src="/icons/pinboard/pin_yellow.png" alt="" class="cork-pin" />
					<img src="/icons/pinboard/note_plain_rose.png" alt="" class="cork-note-bg" />
					<span class="cork-note-title">Coffee morning</span>
					<span class="cork-note-text">Coffee morning is back! Alternating Tues & Thurs, 11am, Science North.</span>
				</div>

				<!-- Note 3: plain, bigger, straight -->
				<div class="cork-note cork-note--plain cork-note--lg" style="top: 10px; left: 46%; transform: rotate(-1deg);">
					<img src="/icons/pinboard/pin_red.png" alt="" class="cork-pin" />
					<img src="/icons/pinboard/note_plain_sage.png" alt="" class="cork-note-bg" />
					<span class="cork-note-title">Want to write?</span>
					<span class="cork-note-text">Check out the submission portal — anyone can contribute a post!</span>
				</div>

				<!-- Note 4: patterned (torn), tilted, small -->
				<div class="cork-note cork-note--patterned cork-note--sm" style="top: 55px; left: 72%; transform: rotate(4deg);">
					<img src="/icons/pinboard/pin_black.png" alt="" class="cork-pin" />
					<img src="/icons/pinboard/note_torn_cream.png" alt="" class="cork-note-bg" />
					<span class="cork-note-text">Anyone have notes from the EPA workshop?</span>
				</div>

				<!-- Note 5: patterned (ringbinder), second row, tilted -->
				<div class="cork-note cork-note--patterned" style="top: 150px; left: 8%; transform: rotate(-2deg);">
					<img src="/icons/pinboard/pin_yellow.png" alt="" class="cork-pin" />
					<img src="/icons/pinboard/note_ringbinder_denim.png" alt="" class="cork-note-bg" />
					<span class="cork-note-text">EMS 2026 abstracts due soon — don't miss the deadline!</span>
				</div>

				<!-- Note 6: patterned (ruled), overlapping note 5 slightly -->
				<div class="cork-note cork-note--patterned" style="top: 145px; left: 35%; transform: rotate(3deg);">
					<img src="/icons/pinboard/pin_red.png" alt="" class="cork-pin" />
					<img src="/icons/pinboard/note_ruled_ochre.png" alt="" class="cork-note-bg" />
					<span class="cork-note-text">New post ideas welcome — ping Lainey!</span>
				</div>

				<!-- Note 7: plain, second row right, tilted opposite -->
				<div class="cork-note cork-note--plain" style="top: 155px; left: 62%; transform: rotate(-4deg);">
					<img src="/icons/pinboard/pin_black.png" alt="" class="cork-pin" />
					<img src="/icons/pinboard/note_plain_rose.png" alt="" class="cork-note-bg" />
					<span class="cork-note-title">Presentation tips</span>
					<span class="cork-note-text">PhD presentation tips — check the blog for Eric Fitzpatrick's advice.</span>
				</div>

				<!-- Note 8: plain, small, tucked in corner -->
				<div class="cork-note cork-note--plain cork-note--sm" style="top: 80px; left: 88%; transform: rotate(1.5deg);">
					<img src="/icons/pinboard/pin_yellow.png" alt="" class="cork-pin" />
					<img src="/icons/pinboard/note_plain_cream.png" alt="" class="cork-note-bg" />
					<span class="cork-note-title">iScholars</span>
					<span class="cork-note-text">Read about the Avolon day with Innovate for Ireland.</span>
				</div>

			</div>
		</div>
	</div>
</section>

<style>
	/* Outer frame — lighter wood tone */
	.corkboard-frame {
		background: #8B6914;
		border-radius: 4px;
		padding: 6px;
		overflow: visible;
		box-shadow:
			0 4px 16px rgba(0, 0, 0, 0.25),
			0 2px 4px rgba(0, 0, 0, 0.15);
	}

	/* Inner frame — darker wood tone */
	.corkboard-frame-inner {
		background: #6B4F12;
		border-radius: 2px;
		padding: 4px;
		overflow: visible;
	}

	/* Cork surface — tiled texture */
	.corkboard-surface {
		background-image: url('/textures/corkboard.png');
		background-repeat: repeat;
		background-size: 256px 256px;
		image-rendering: pixelated;
		image-rendering: -moz-crisp-edges;
		min-height: 280px;
		border-radius: 1px;
		position: relative;
		padding: 1.5rem;
		box-shadow: inset 0 2px 8px rgba(0, 0, 0, 0.15);
		overflow: visible;
	}

	@media (min-width: 768px) {
		.corkboard-surface {
			min-height: 340px;
		}
	}

	/* --- Note base --- */
	.cork-note {
		position: absolute;
		width: 96px;
		height: 96px;
		transition: transform 0.2s ease, z-index 0s;
		cursor: default;
	}

	/* Size variants */
	.cork-note--lg {
		width: 112px;
		height: 112px;
	}
	.cork-note--lg .cork-note-bg {
		width: 112px;
		height: 112px;
	}

	.cork-note--sm {
		width: 80px;
		height: 80px;
	}
	.cork-note--sm .cork-note-bg {
		width: 80px;
		height: 80px;
	}

	/* Hover: zoom big, preserve the existing rotation */
	.cork-note:hover {
		transform: scale(2.2) rotate(0deg) !important;
		z-index: 20;
	}

	/* Note background sprite */
	.cork-note-bg {
		width: 96px;
		height: 96px;
		image-rendering: pixelated;
		image-rendering: -moz-crisp-edges;
		display: block;
		pointer-events: none;
	}

	/* Pin sprite — centred on top */
	.cork-pin {
		width: 24px;
		height: 24px;
		image-rendering: pixelated;
		image-rendering: -moz-crisp-edges;
		position: absolute;
		top: -10px;
		left: 50%;
		transform: translateX(-50%);
		z-index: 3;
		pointer-events: none;
	}

	/* --- Abbreviated title (plain notes only) --- */
	.cork-note-title {
		position: absolute;
		top: 20px;
		left: 10px;
		right: 10px;
		font-size: 8px;
		line-height: 1.3;
		color: #3a3024;
		font-family: var(--font-meta);
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.03em;
		overflow: hidden;
		pointer-events: none;
		z-index: 2;
		transition: opacity 0.2s ease;
	}

	/* Hide title on hover (replaced by full text) */
	.cork-note:hover .cork-note-title {
		opacity: 0;
	}

	/* --- Full text (shown on hover) --- */
	.cork-note-text {
		position: absolute;
		top: 18px;
		left: 14px;
		right: 14px;
		bottom: 14px;
		font-size: 9px;
		line-height: 1.35;
		color: #3a3024;
		font-family: var(--font-meta);
		overflow: hidden;
		pointer-events: none;
		opacity: 0;
		transition: opacity 0.2s ease;
		z-index: 2;
	}

	.cork-note:hover .cork-note-text {
		opacity: 1;
	}

	/* --- Patterned notes: opaque overlay on hover so text is readable --- */
	.cork-note--patterned::after {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		background: rgba(255, 255, 250, 0.85);
		opacity: 0;
		transition: opacity 0.2s ease;
		pointer-events: none;
		z-index: 1;
	}

	.cork-note--patterned:hover::after {
		opacity: 1;
	}

	/* Plain notes: semi-transparent overlay on hover for text contrast */
	.cork-note--plain::after {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		background: rgba(255, 255, 250, 0.5);
		opacity: 0;
		transition: opacity 0.2s ease;
		pointer-events: none;
		z-index: 1;
	}

	.cork-note--plain:hover::after {
		opacity: 1;
	}
</style>
