---
/**
 * Interactive pixel-art corkboard.
 * Notes stored in Upstash Redis, visible to everyone.
 * Session-based ownership for deletion.
 *
 * Flow: click stack → note follows cursor → click board to place →
 *       type directly on note → click outside or Enter to save.
 */
---

<section class="app-container pt-16">
	<h2
		class="font-meta text-xs uppercase tracking-[0.2em] text-foreground/70 dark:text-foreground-dark/70 font-medium mb-4"
	>
		Pinboard
	</h2>

	<div class="corkboard-outer">
		<div class="corkboard-frame">
			<div class="corkboard-frame-inner">
				<div class="corkboard-surface" id="corkboard-surface"></div>
			</div>
		</div>

		<!-- Trash — overlaps bottom-right of board -->
		<div class="cork-trash" id="cork-trash" title="Select your note, then click here to delete">
			<img src="/icons/pinboard/bin.svg" alt="Trash" class="cork-trash-img" />
		</div>
	</div>

	<!-- Stack note below the board -->
	<div class="corkboard-controls">
		<div class="cork-stack" id="cork-stack" title="Click to grab a note!">
			<img src="/icons/pinboard/pin_red.png" alt="" class="cork-stack-pin" />
			<img
				src="/icons/pinboard/note_plain_cream.png"
				alt=""
				class="cork-stack-bg"
				id="cork-stack-img"
			/>
			<span class="cork-stack-label">Click me!</span>
		</div>
	</div>

	<!-- Ghost note that follows cursor -->
	<div class="cork-ghost" id="cork-ghost">
		<img src="/icons/pinboard/pin_red.png" alt="" class="cork-ghost-pin" />
		<img
			src="/icons/pinboard/note_plain_cream.png"
			alt=""
			class="cork-ghost-bg"
			id="cork-ghost-img"
		/>
	</div>
</section>

<style>
	.corkboard-outer {
		position: relative;
	}

	.corkboard-frame {
		background: #8b6914;
		border-radius: 4px;
		padding: 6px;
		overflow: visible;
		box-shadow:
			0 4px 16px rgba(0, 0, 0, 0.25),
			0 2px 4px rgba(0, 0, 0, 0.15);
	}
	.corkboard-frame-inner {
		background: #6b4f12;
		border-radius: 2px;
		padding: 4px;
		overflow: visible;
	}
	.corkboard-surface {
		background-image: url('/textures/corkboard.png');
		background-repeat: repeat;
		background-size: 256px 256px;
		image-rendering: pixelated;
		image-rendering: -moz-crisp-edges;
		min-height: 300px;
		border-radius: 1px;
		position: relative;
		box-shadow: inset 0 2px 8px rgba(0, 0, 0, 0.15);
		overflow: visible;
		cursor: default;
	}
	.corkboard-surface.placing {
		cursor: none;
	}
	@media (min-width: 768px) {
		.corkboard-surface {
			min-height: 360px;
		}
	}

	/* --- Trash: sitting on the floor, overlapping board bottom-right --- */
	.cork-trash {
		position: absolute;
		bottom: -160px;
		right: -30px;
		width: 220px;
		height: 242px;
		cursor: default;
		transition: transform 0.15s ease;
		z-index: 10;
	}
	.cork-trash.active {
		cursor: pointer;
	}
	.cork-trash.active:hover {
		transform: scale(1.15);
	}
	.cork-trash-img {
		width: 100%;
		height: 100%;
		object-fit: contain;
	}

	/* --- Controls --- */
	.corkboard-controls {
		display: flex;
		align-items: flex-end;
		margin-top: 1.5rem;
		padding: 0 0.5rem;
	}

	.cork-stack {
		position: relative;
		width: 96px;
		height: 96px;
		cursor: pointer;
		transition: transform 0.15s ease;
	}
	.cork-stack:hover {
		transform: scale(1.1);
	}
	.cork-stack-pin {
		width: 24px;
		height: 24px;
		image-rendering: pixelated;
		position: absolute;
		top: -10px;
		left: 50%;
		transform: translateX(-50%);
		z-index: 2;
		pointer-events: none;
	}
	.cork-stack-bg {
		width: 96px;
		height: 96px;
		image-rendering: pixelated;
		image-rendering: -moz-crisp-edges;
		display: block;
	}
	.cork-stack-label {
		position: absolute;
		top: 24px;
		left: 0;
		right: 0;
		text-align: center;
		font-family: var(--font-meta);
		font-size: 10px;
		font-weight: 600;
		color: #3a3024;
		pointer-events: none;
	}

	/* --- Ghost note (follows cursor) --- */
	.cork-ghost {
		position: fixed;
		width: 96px;
		height: 96px;
		pointer-events: none;
		z-index: 1000;
		display: none;
		opacity: 0.85;
	}
	.cork-ghost.visible {
		display: block;
	}
	.cork-ghost-pin {
		width: 24px;
		height: 24px;
		image-rendering: pixelated;
		position: absolute;
		top: -10px;
		left: 50%;
		transform: translateX(-50%);
	}
	.cork-ghost-bg {
		width: 96px;
		height: 96px;
		image-rendering: pixelated;
		image-rendering: -moz-crisp-edges;
		display: block;
	}

	/* --- Notes on the board --- */
	:global(.cork-note) {
		position: absolute;
		width: 96px;
		height: 96px;
		transition: transform 0.2s ease;
		cursor: default;
	}
	:global(.cork-note:hover) {
		transform: scale(2.2) rotate(0deg) !important;
		z-index: 20;
	}
	:global(.cork-note.editing) {
		transform: scale(2.5) rotate(0deg) !important;
		z-index: 30;
	}
	:global(.cork-note-bg) {
		width: 96px;
		height: 96px;
		image-rendering: pixelated;
		image-rendering: -moz-crisp-edges;
		display: block;
		pointer-events: none;
	}
	:global(.cork-pin) {
		width: 24px;
		height: 24px;
		image-rendering: pixelated;
		image-rendering: -moz-crisp-edges;
		position: absolute;
		top: -10px;
		left: 50%;
		transform: translateX(-50%);
		z-index: 3;
		pointer-events: none;
	}

	/* Abbreviated title at rest */
	:global(.cork-note-title) {
		position: absolute;
		top: 24px;
		left: 18px;
		right: 18px;
		font-size: 8px;
		line-height: 1.3;
		color: #3a3024;
		font-family: var(--font-meta);
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.03em;
		overflow: hidden;
		pointer-events: none;
		z-index: 2;
		transition: opacity 0.2s ease;
	}
	:global(.cork-note:hover .cork-note-title),
	:global(.cork-note.editing .cork-note-title) {
		opacity: 0;
	}

	/* Full text — scrollable on hover */
	:global(.cork-note-text) {
		position: absolute;
		top: 22px;
		left: 18px;
		right: 18px;
		bottom: 18px;
		font-size: 9px;
		line-height: 1.35;
		color: #3a3024;
		font-family: var(--font-meta);
		overflow: hidden;
		pointer-events: none;
		opacity: 0;
		transition: opacity 0.2s ease;
		z-index: 2;
	}
	:global(.cork-note:hover .cork-note-text) {
		opacity: 1;
		overflow-y: auto;
		pointer-events: auto;
		scrollbar-width: thin;
		scrollbar-color: rgba(0, 0, 0, 0.2) transparent;
	}
	:global(.cork-note-text::-webkit-scrollbar) {
		width: 3px;
	}
	:global(.cork-note-text::-webkit-scrollbar-thumb) {
		background: rgba(0, 0, 0, 0.2);
		border-radius: 2px;
	}
	/* Disable hover zoom while dragging */
	:global(.cork-note.dragging),
	:global(.cork-note.dragging:hover) {
		transform: rotate(0deg) !important;
		z-index: 25 !important;
		transition: none !important;
		cursor: grabbing !important;
	}
	:global(.cork-note.dragging .cork-note-title),
	:global(.cork-note.dragging .cork-note-text) {
		opacity: 0 !important;
	}
	:global(.cork-note.dragging::after) {
		opacity: 0 !important;
	}

	/* Inline edit textarea */
	:global(.cork-note-edit) {
		position: absolute;
		top: 22px;
		left: 18px;
		right: 18px;
		bottom: 18px;
		font-size: 9px;
		line-height: 1.35;
		color: #3a3024;
		font-family: var(--font-meta);
		background: transparent;
		border: none;
		outline: none;
		resize: none;
		z-index: 4;
		overflow-y: auto;
	}

	/* Overlay — constrained to note sprite */
	:global(.cork-note::after) {
		content: '';
		position: absolute;
		top: 2px;
		left: 2px;
		right: 2px;
		bottom: 2px;
		background: rgba(255, 255, 250, 0.5);
		opacity: 0;
		transition: opacity 0.2s ease;
		pointer-events: none;
		z-index: 1;
	}
	:global(.cork-note:hover::after),
	:global(.cork-note.editing::after) {
		opacity: 1;
	}
	:global(.cork-note.own) {
		cursor: pointer;
	}
	:global(.cork-note.selected) {
		outline: 2px dashed #c0392b;
		outline-offset: 3px;
	}
</style>

<script is:inline>
	;(function () {
		var NOTE_SPRITES = [
			'note_plain_cream.png',
			'note_plain_rose.png',
			'note_plain_sage.png',
			'note_plain_denim.png',
			'note_plain_ochre.png',
			'note_torn_cream.png',
			'note_ruled_ochre.png',
			'note_ringbinder_denim.png',
		]
		var PINS = ['pin_red', 'pin_yellow', 'pin_black']
		var MAX_TEXT = 80

		if (!sessionStorage.getItem('cork-session')) {
			sessionStorage.setItem('cork-session', crypto.randomUUID())
		}
		var sessionId = sessionStorage.getItem('cork-session')

		var surface = document.getElementById('corkboard-surface')
		var stack = document.getElementById('cork-stack')
		var stackImg = document.getElementById('cork-stack-img')
		var trash = document.getElementById('cork-trash')
		var ghost = document.getElementById('cork-ghost')
		var ghostImg = document.getElementById('cork-ghost-img')
		if (!surface || !stack || !trash || !ghost || !ghostImg || !stackImg) return

		var spriteIdx = 0
		var placing = false
		var editing = null // the note div currently being edited
		var notes = []

		function currentSprite() {
			return NOTE_SPRITES[spriteIdx % NOTE_SPRITES.length]
		}
		function spriteUrl(sprite) {
			return '/icons/pinboard/' + sprite
		}
		function randomTilt() {
			return (Math.random() * 8 - 4).toFixed(1)
		}
		function randomPin() {
			return PINS[Math.floor(Math.random() * PINS.length)]
		}
		function abbreviate(text) {
			var words = text.split(/\s+/)
			return words.length <= 3 ? text : words.slice(0, 3).join(' ') + '\u2026'
		}

		// --- Drag state (single global handler, not per-note) ---
		var dragState = {
			active: false,
			noteDiv: null,
			noteData: null,
			startX: 0,
			startY: 0,
			origLeft: 0,
			origTop: 0,
			moved: false,
		}

		document.addEventListener('mousemove', function (e) {
			if (!dragState.active) return
			var dx = e.clientX - dragState.startX
			var dy = e.clientY - dragState.startY
			if (Math.abs(dx) > 3 || Math.abs(dy) > 3) dragState.moved = true
			dragState.noteDiv.style.left = dragState.origLeft + dx + 'px'
			dragState.noteDiv.style.top = dragState.origTop + dy + 'px'
		})

		document.addEventListener('mouseup', function (e) {
			if (!dragState.active) return
			dragState.active = false
			var div = dragState.noteDiv
			var noteData = dragState.noteData
			div.classList.remove('dragging')
			div.style.zIndex = ''

			// Check if dropped on trash
			var trashRect = trash.getBoundingClientRect()
			if (
				e.clientX >= trashRect.left &&
				e.clientX <= trashRect.right &&
				e.clientY >= trashRect.top &&
				e.clientY <= trashRect.bottom
			) {
				fetch('/api/pinboard', {
					method: 'DELETE',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ id: noteData.id, sessionId: sessionId }),
				})
					.then(function (r) { return r.json() })
					.then(function (data) {
						if (data.ok) {
							notes = notes.filter(function (n) { return n.id !== noteData.id })
							renderNotes()
						}
					})
					.catch(function () {})
				trash.classList.remove('active')
				return
			}

			trash.classList.remove('active')
			if (!dragState.moved) return

			// Update position in Redis
			var rect = surface.getBoundingClientRect()
			var newX = (div.offsetLeft / rect.width) * 100
			var newY = div.offsetTop
			noteData.x = newX
			noteData.y = newY

			fetch('/api/pinboard', {
				method: 'PATCH',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ id: noteData.id, sessionId: sessionId, x: newX, y: newY }),
			}).catch(function () {})
		})

		// --- Ghost follows cursor ---
		document.addEventListener('mousemove', function (e) {
			if (!placing) return
			ghost.style.left = e.clientX - 48 + 'px'
			ghost.style.top = e.clientY - 48 + 'px'
		})

		// --- Render saved notes ---
		function renderNotes() {
			surface.innerHTML = ''
			notes.forEach(function (note) {
				var div = document.createElement('div')
				div.className = 'cork-note' + (note.sessionId === sessionId ? ' own' : '')
				div.style.cssText =
					'left:' +
					note.x +
					'%;top:' +
					note.y +
					'px;transform:rotate(' +
					note.tilt +
					'deg);'
				div.dataset.id = note.id

				var pin = document.createElement('img')
				pin.src = '/icons/pinboard/' + (note.pin || 'pin_red') + '.png'
				pin.alt = ''
				pin.className = 'cork-pin'

				var bg = document.createElement('img')
				bg.src = spriteUrl(note.sprite || 'note_plain_cream.png')
				bg.alt = ''
				bg.className = 'cork-note-bg'

				var title = document.createElement('span')
				title.className = 'cork-note-title'
				title.textContent = abbreviate(note.text)

				var text = document.createElement('span')
				text.className = 'cork-note-text'
				text.textContent = note.text

				div.appendChild(pin)
				div.appendChild(bg)
				div.appendChild(title)
				div.appendChild(text)

				// Own notes: enable drag
				if (note.sessionId === sessionId) {
					div.addEventListener('mousedown', function (e) {
						if (editing) return
						e.preventDefault()
						e.stopPropagation()
						dragState.active = true
						dragState.noteDiv = div
						dragState.noteData = note
						dragState.startX = e.clientX
						dragState.startY = e.clientY
						dragState.origLeft = div.offsetLeft
						dragState.origTop = div.offsetTop
						dragState.moved = false
						div.classList.add('dragging')
						div.style.zIndex = '25'
						trash.classList.add('active')
					})
				}

				surface.appendChild(div)
			})
		}

		// --- Load from API ---
		function loadNotes() {
			fetch('/api/pinboard')
				.then(function (r) {
					return r.json()
				})
				.then(function (data) {
					notes = data.notes || []
					renderNotes()
				})
				.catch(function () {})
		}

		// --- Click stack: grab a note ---
		stack.addEventListener('click', function () {
			if (editing) return
			if (placing) {
				// Cancel
				placing = false
				surface.classList.remove('placing')
				ghost.classList.remove('visible')
				return
			}
			spriteIdx++
			var spr = currentSprite()
			stackImg.src = spriteUrl(spr)
			ghostImg.src = spriteUrl(spr)
			placing = true
			surface.classList.add('placing')
			ghost.classList.add('visible')
			// Deselect
			surface.querySelectorAll('.cork-note.selected').forEach(function (el) {
				el.classList.remove('selected')
			})
			trash.classList.remove('active')
		})

		// --- Click board: place note + inline edit ---
		surface.addEventListener('click', function (e) {
			if (editing) return
			if (!placing) return

			var rect = surface.getBoundingClientRect()
			var xPct = (((e.clientX - rect.left) / rect.width) * 100).toFixed(1)
			var yPx = Math.max(0, Math.round(e.clientY - rect.top - 48))
			var tilt = randomTilt()
			var notePin = randomPin()
			var spr = currentSprite()

			// Hide ghost
			placing = false
			surface.classList.remove('placing')
			ghost.classList.remove('visible')

			// Create editable note on board
			var div = document.createElement('div')
			div.className = 'cork-note editing'
			div.style.cssText =
				'left:' + xPct + '%;top:' + yPx + 'px;transform:rotate(' + tilt + 'deg);'

			var pin = document.createElement('img')
			pin.src = '/icons/pinboard/' + notePin + '.png'
			pin.alt = ''
			pin.className = 'cork-pin'

			var bg = document.createElement('img')
			bg.src = spriteUrl(spr)
			bg.alt = ''
			bg.className = 'cork-note-bg'

			var textarea = document.createElement('textarea')
			textarea.className = 'cork-note-edit'
			textarea.maxLength = MAX_TEXT
			textarea.placeholder = 'Type here...'

			div.appendChild(pin)
			div.appendChild(bg)
			div.appendChild(textarea)
			surface.appendChild(div)
			editing = div

			// Focus after a tick (transform needs to settle)
			setTimeout(function () {
				textarea.focus()
			}, 50)

			// Save on Enter
			textarea.addEventListener('keydown', function (ev) {
				if (ev.key === 'Enter' && !ev.shiftKey) {
					ev.preventDefault()
					saveNote(div, textarea, spr, xPct, yPx, tilt, notePin)
				}
				if (ev.key === 'Escape') {
					div.remove()
					editing = null
				}
			})

			// Save on blur (click outside or tab away)
			textarea.addEventListener('blur', function () {
				// Small delay so Enter keydown can fire first
				setTimeout(function () {
					if (editing === div) {
						saveNote(div, textarea, spr, xPct, yPx, tilt, notePin)
					}
				}, 150)
			})
		})

		function saveNote(div, textarea, sprite, xPct, yPx, tilt, notePin) {
			if (editing !== div) return // already saved
			var text = textarea.value.trim().slice(0, MAX_TEXT)
			editing = null

			if (!text) {
				div.remove()
				return
			}

			// Immediately convert to display mode so note stays visible
			div.classList.remove('editing')
			textarea.remove()
			var title = document.createElement('span')
			title.className = 'cork-note-title'
			title.textContent = abbreviate(text)
			var textSpan = document.createElement('span')
			textSpan.className = 'cork-note-text'
			textSpan.textContent = text
			div.appendChild(title)
			div.appendChild(textSpan)
			div.classList.add('own')

			var note = {
				text: text,
				sprite: sprite,
				x: parseFloat(xPct),
				y: parseInt(yPx),
				tilt: parseFloat(tilt),
				pin: notePin,
				sessionId: sessionId,
			}

			fetch('/api/pinboard', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify(note),
			})
				.then(function (r) {
					return r.json()
				})
				.then(function (data) {
					if (data.ok && data.note) {
						data.note.pin = notePin
						notes.unshift(data.note)
						renderNotes()
					}
				})
				.catch(function () {})

			editing = null
		}

		// --- Trash ---
		trash.addEventListener('click', function () {
			var selected = surface.querySelector('.cork-note.selected')
			if (!selected) return
			var noteId = selected.dataset.id

			fetch('/api/pinboard', {
				method: 'DELETE',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ id: noteId, sessionId: sessionId }),
			})
				.then(function (r) {
					return r.json()
				})
				.then(function (data) {
					if (data.ok) {
						notes = notes.filter(function (n) {
							return n.id !== noteId
						})
						renderNotes()
					}
				})
				.catch(function () {})

			trash.classList.remove('active')
		})

		loadNotes()
	})()
</script>
