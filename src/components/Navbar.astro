---
import NavbarLink from './NavbarLink.astro'
import { Icon } from 'astro-icon/components'
import ThemeSelector from './ThemeSelector.astro'
import { WebsiteLinks, TRACKS } from '../consts'
import { SITE_TITLE } from '../consts'

interface Props {
	title?: string
	transparent?: boolean
}

const { pathname } = Astro.url
const blogActive = pathname.startsWith('/blog') || pathname.startsWith('/tracks')
// The homepage hero shows the big title, so drop the bar wordmark there (desktop)
const isHome = pathname === '/'
// Wordmark with a teal accent on the first word ("The")
const [titleFirst, ...titleRestParts] = SITE_TITLE.split(' ')
const titleRest = titleRestParts.length ? ' ' + titleRestParts.join(' ') : ''
---

<header
	class="absolute top-0 w-full z-[60] bg-background dark:bg-background-dark border-b border-foreground/10 dark:border-foreground-dark/15 transition-colors"
>
	<nav class="app-container py-[9px]">
		<!-- Mobile bar -->
		<div class="flex items-center justify-between gap-4 xl:hidden">
			<a
				href="/"
				class="font-display text-[19px] font-bold tracking-[-0.01em] whitespace-nowrap"
			>
				<span class="italic text-primary dark:text-primary-dark">{titleFirst}</span>{titleRest}
			</a>
			<button
				class="cursor-pointer"
				id="nav-open-btn"
				aria-label="Open navigation menu"
				title="Open navigation menu"
			>
				<Icon aria-hidden name="mdi:menu" size={30} />
			</button>
		</div>

		<!-- Desktop bar: wordmark left · nav centred · CTAs right -->
		<div class="hidden xl:grid grid-cols-[1fr_auto_1fr] items-center gap-[24px]">
			<div class="justify-self-start">
				{
					!isHome && (
						<a
							href="/"
							class="font-display text-[20px] font-bold tracking-[-0.01em] whitespace-nowrap hover:opacity-70 transition-opacity"
						>
							<span class="italic text-primary dark:text-primary-dark">{titleFirst}</span>
							{titleRest}
						</a>
					)
				}
			</div>

			<div class="flex items-center gap-[24px] justify-self-center">
				<div class="relative flex items-center" id="tracks-dropdown">
					<a
						href="/blog"
						class:list={[
							'font-meta uppercase font-medium leading-none text-xs tracking-[0.18em] text-foreground/70 dark:text-foreground-dark/70 hover:text-primary dark:hover:text-primary-dark transition-colors',
							{ 'text-primary dark:text-primary-dark': blogActive },
						]}
					>
						Blog
					</a>
					<div class="absolute top-full left-1/2 -translate-x-1/2 pt-3 hidden" id="tracks-menu">
						<div class="bg-background dark:bg-background-dark border border-foreground/10 dark:border-foreground-dark/10 rounded-lg py-2 min-w-[160px] shadow-lg">
							{TRACKS.map((track) => (
								<a
									href={`/tracks/${track.slug}/`}
									class="block px-4 py-2 font-meta uppercase font-medium text-xs tracking-[0.18em] text-foreground/70 dark:text-foreground-dark/70 hover:bg-foreground/5 dark:hover:bg-foreground-dark/5 transition-colors"
								>
									{track.label}
								</a>
							))}
						</div>
					</div>
				</div>
				{
					WebsiteLinks.filter(
						(l) => !['Home', 'Blog', 'Contribute', 'Subscribe'].includes(l.name)
					).map((link) => (
						<NavbarLink
							class="font-meta uppercase font-medium leading-none text-xs tracking-[0.18em] text-foreground/70 dark:text-foreground-dark/70 whitespace-nowrap"
							href={`/${link.url}`}
							target={link.url.charAt(0) === 'h' ? '_blank' : '_self'}
						>
							{link.name}
						</NavbarLink>
					))
				}
			</div>

			<div class="flex items-center gap-[14px] justify-self-end">
				<ThemeSelector />
				<a href="/#subscribe" class="btn-pixel btn-pixel-sm relative top-[-2px]">Subscribe</a>
				<a href="/submit/" class="btn-pixel btn-pixel-red btn-pixel-sm relative top-[-2px]">Contribute</a>
			</div>
		</div>

		<!-- Mobile slide-in menu -->
		<div
			class="translate-x-full xl:hidden fixed top-0 right-0 bg-background dark:bg-background-dark h-screen w-5/6 px-8 py-6 transition-transform z-40 border-l-[1px] border-background"
			id="mobile-menu"
		>
			<button
				id="nav-close-btn"
				class="ml-auto block cursor-pointer"
				aria-label="Close navigation menu"
				title="Close navigation menu"
			>
				<Icon aria-hidden name="mdi:close" size={32} />
			</button>
			<div class="flex flex-col h-full items-start gap-8 pt-16">
				{
					WebsiteLinks.filter((l) => l.name !== 'Blog').map((link) => (
						<>
							{link.name === 'Contribute' ? (
								<a href={`/${link.url}/`} class="btn-pixel btn-pixel-red btn-pixel-sm">
									{link.name}
								</a>
							) : link.name === 'Subscribe' ? (
								<a href={`/${link.url}`} class="btn-pixel btn-pixel-sm">
									{link.name}
								</a>
							) : (
								<NavbarLink class="text-4xl font-light" href={`/${link.url}`}>
									{link.name}
								</NavbarLink>
							)}
							{link.name === 'Home' && (
								<>
									<NavbarLink class="text-4xl font-light" href="/blog">
										Blog
									</NavbarLink>
									<div class="flex flex-col gap-4 pl-4">
										{TRACKS.map((track) => (
											<a
												href={`/tracks/${track.slug}/`}
												class="text-2xl font-light opacity-80 hover:opacity-100"
											>
												{track.label}
											</a>
										))}
									</div>
								</>
							)}
						</>
					))
				}
				<ThemeSelector class:list="mt-4" />
			</div>
		</div>
	</nav>

	<script>
		function toggleNav() {
			document
				.querySelector('#mobile-menu')
				?.classList.toggle('mobile-nav-open')
		}

		document
			.querySelector('#nav-open-btn')
			?.addEventListener('click', toggleNav)
		document
			.querySelector('#nav-close-btn')
			?.addEventListener('click', toggleNav)

		const dropdown = document.querySelector('#tracks-dropdown')
		const menu = document.querySelector('#tracks-menu')
		if (dropdown && menu) {
			dropdown.addEventListener('mouseenter', () => {
				menu.classList.remove('hidden')
			})
			dropdown.addEventListener('mouseleave', () => {
				menu.classList.add('hidden')
			})
		}
	</script>
</header>

<script is:inline>
	function reComputeTheme() {
		if (
			localStorage.theme === 'dark' ||
			(!('theme' in localStorage) &&
				window.matchMedia('(prefers-color-scheme: dark)').matches)
		) {
			document.documentElement.classList.add('dark')
		} else {
			document.documentElement.classList.remove('dark')
		}

		document
			.querySelectorAll('.theme-button.active')
			.forEach((el) => el.classList.remove('active'))
		const resolved = document.documentElement.classList.contains('dark')
			? 'dark'
			: 'light'
		const theme = localStorage.theme || resolved
		document
			.querySelectorAll(`[data-theme="theme-${theme}"]`)
			.forEach((el) => el.classList.add('active'))
	}

	function addThemeEventListeners() {
		themeButtons = document.querySelectorAll('.theme-button')
		themeButtons.forEach((button) => {
			button.addEventListener('click', () => {
				themeButtons.forEach((btn) => btn.classList.remove('active'))
				button.classList.add('active')
				if (button.dataset.theme === 'theme-auto') {
					localStorage.removeItem('theme')
					reComputeTheme()
				} else {
					localStorage.theme = button.dataset.theme.replace('theme-', '')
					document.documentElement.classList.toggle(
						'dark',
						button.dataset.theme === 'theme-dark'
					)
				}
			})
		})
	}

	// Set active class on OS theme change
	window
		.matchMedia('(prefers-color-scheme: dark)')
		.addEventListener('change', (_e) => {
			reComputeTheme()
		})

	// run recomputeTheme when screen crosses the desktop breakpoint
	window.matchMedia('(min-width: 1280px)').addEventListener('change', (_e) => {
		addThemeEventListeners()
		reComputeTheme()
	})

	reComputeTheme()

	// Run on page load
	window.addEventListener('DOMContentLoaded', () => {
		addThemeEventListeners()
		reComputeTheme()
	})
</script>
