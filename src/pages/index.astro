---
import BaseLayout from '../layouts/BaseLayout.astro'
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts'
import BlogCard from '../components/BlogCard.astro'
import FeaturedCard from '../components/FeaturedCard.astro'
import ParallaxHero from '../components/ParallaxHero.astro'
import Corkboard from '../components/Corkboard.astro'
import SubscribeForm from '../components/SubscribeForm.astro'
import { getCollection } from 'astro:content'

const allPosts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
)

const featured = allPosts.filter((p) => p.data.featured)
const latest = allPosts.filter((p) => !p.data.featured)

const authors = await getCollection('authors')
const heroAvatars = authors.map((a) => ({
	id: a.id,
	avatar: a.data.avatar,
	name: a.data.name,
}))
---

<BaseLayout hero>
	<div>
		<!-- Hero -->
		<ParallaxHero avatars={heroAvatars}>
			<div class="h-full app-container relative">
				<!-- Centered at 42% of hero height: below the nav, above the grass
				     line (~73%) at any viewport. Title scales with viewport height. -->
				<div class="absolute top-[48%] -translate-y-1/2">
					<h1
						class="font-display text-4xl sm:text-5xl md:text-[clamp(2.5rem,9vh,3.75rem)] font-bold text-white leading-[1.05] tracking-[-0.01em]"
					>
						{SITE_TITLE}
					</h1>
					<p
						class="text-lg sm:text-xl text-white/90 mt-5 max-w-lg font-semibold leading-[1.5]"
					>
						{SITE_DESCRIPTION}
					</p>
				</div>
			</div>
		</ParallaxHero>

		<!-- Featured — sits directly under the hero so it's visible without a full scroll -->
		<section class="app-container pt-6 pb-4">
			<h2
				class="font-meta text-xs uppercase tracking-[0.2em] text-foreground/70 dark:text-foreground-dark/70 font-medium mb-4"
			>
				Featured
			</h2>
			<div class="grid grid-cols-1 gap-14 md:grid-cols-2">
				{featured.map((post) => <FeaturedCard post={post} />)}
			</div>
		</section>
	</div>

	<!-- Corkboard -->
	<Corkboard />

	<!-- Latest -->
	{
		latest.length > 0 && (
			<section class="app-container pt-16 pb-24">
				<h2 class="font-meta text-xs uppercase tracking-[0.2em] text-foreground/70 dark:text-foreground-dark/70 font-medium mb-4">
					Latest
				</h2>
				<div class="grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
					{latest.map((post) => (
						<BlogCard post={post} />
					))}
				</div>
			</section>
		)
	}

	<!-- Subscribe -->
	<SubscribeForm />
</BaseLayout>
