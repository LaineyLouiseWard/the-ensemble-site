---
import BaseLayout from '../layouts/BaseLayout.astro'
import { TRACKS } from '../consts'
import { getCollection } from 'astro:content'

const authors = await getCollection('authors')
const authorNames = authors.map((a) => a.data.name)

const avatarSets = Array.from(
	{ length: 52 },
	(_, i) => `Set1_${String(i + 1).padStart(3, '0')}`
)
	.concat(
		Array.from(
			{ length: 51 },
			(_, i) => `Set2_${String(i + 1).padStart(3, '0')}`
		)
	)
	.filter((id) => id !== 'Set2_029')
---

<BaseLayout
	title="Submit a Post"
	description="Submit an article to The Ensemble Edit."
>
	<main class="app-container pt-36">
		<h1 class="text-6xl pb-2 font-bold">Submit a Blog Post</h1>
	</main>
	<section class="app-container py-12 mb-8">
		<div class="max-w-2xl">
			<p class="text-lg mb-8 text-foreground/70 dark:text-foreground-dark/70">
				Fill in the form below and your post will be reviewed and formatted by
				the editorial team. Want more control via GitHub? See the <a
					href="/blog/instructions-for-authors/"
					class="underline underline-offset-4 hover:text-primary dark:hover:text-primary-dark transition-colors"
					>instructions for authors</a
				>.
			</p>

			<form id="submit-form" class="space-y-6">
				<!-- Honeypot -->
				<div
					style="position:absolute;left:-9999px;opacity:0;height:0;overflow:hidden;"
					aria-hidden="true"
				>
					<input type="text" name="website" autocomplete="off" tabindex="-1" />
				</div>

				<div>
					<label
						for="field-name"
						class="block font-meta text-sm mb-1.5 text-foreground/60 dark:text-foreground-dark/60"
					>
						Your name <span class="text-red-500">*</span>
					</label>
					<input
						type="text"
						id="field-name"
						name="name"
						required
						list="name-suggestions"
						placeholder="Type your name or select Anonymous"
						class="w-full bg-transparent border border-foreground/15 dark:border-foreground-dark/15 focus:border-foreground/50 dark:focus:border-foreground-dark/50 outline-none px-3 py-2 rounded-lg transition-colors placeholder:text-foreground/30 dark:placeholder:text-foreground-dark/30"
					/>
					<datalist id="name-suggestions">
						<option value="Anonymous"></option>
						{authorNames.map((name) => <option value={name} />)}
					</datalist>
				</div>

				<div id="email-section">
					<label
						for="field-email"
						class="block font-meta text-sm mb-1.5 text-foreground/60 dark:text-foreground-dark/60"
					>
						Email <span class="text-red-500" id="email-required-star">*</span>
						<span
							id="email-optional-note"
							class="text-foreground/30 dark:text-foreground-dark/30 hidden"
							>(optional)</span
						>
					</label>
					<input
						type="email"
						id="field-email"
						name="email"
						required
						class="w-full bg-transparent border border-foreground/15 dark:border-foreground-dark/15 focus:border-foreground/50 dark:focus:border-foreground-dark/50 outline-none px-3 py-2 rounded-lg transition-colors"
					/>
					<label
						for="field-subscribe"
						class="flex items-start gap-2 mt-2 font-meta text-sm text-foreground/60 dark:text-foreground-dark/60 cursor-pointer"
					>
						<input type="checkbox" id="field-subscribe" name="subscribe" class="mt-1" />
						<span>Also email me when new posts go up</span>
					</label>
				</div>

				<div>
					<label
						class="block font-meta text-sm mb-1.5 text-foreground/60 dark:text-foreground-dark/60"
					>
						Choose your avatar <span
							class="text-foreground/30 dark:text-foreground-dark/30"
							>(optional)</span
						>
					</label>
					<input type="hidden" id="field-avatar" name="avatar" value="" />
					<div
						class="grid grid-cols-8 sm:grid-cols-10 gap-1.5 max-h-64 overflow-y-auto border border-foreground/15 dark:border-foreground-dark/15 rounded-lg p-2"
						id="avatar-grid"
					>
						{
							avatarSets.map((id) => (
								<button
									type="button"
									data-avatar={id}
									class="avatar-option aspect-square rounded-md border-2 border-transparent hover:border-foreground/30 dark:hover:border-foreground-dark/30 transition-colors overflow-hidden cursor-pointer"
								>
									<img
										src={`/avatars/${id}.png`}
										alt={id}
										class="w-full h-full object-contain"
										loading="lazy"
									/>
								</button>
							))
						}
					</div>
					<p
						class="font-meta text-xs mt-1 text-foreground/40 dark:text-foreground-dark/40"
						id="avatar-selection-text"
					>
						No avatar selected
					</p>
				</div>

				<div
					id="profile-section"
					class="hidden border border-foreground/15 dark:border-foreground-dark/15 rounded-lg p-4 space-y-4"
				>
					<p
						class="font-meta text-sm text-foreground/60 dark:text-foreground-dark/60"
					>
						New here? Fill in a few details for your author profile <span
							class="text-foreground/30 dark:text-foreground-dark/30"
							>(all optional)</span
						>
					</p>
					<div>
						<label
							for="field-bio"
							class="block font-meta text-sm mb-1.5 text-foreground/60 dark:text-foreground-dark/60"
							>Short bio</label
						>
						<input
							type="text"
							id="field-bio"
							name="bio"
							placeholder="e.g. I'm a second year PhD student working on..."
							class="w-full bg-transparent border border-foreground/15 dark:border-foreground-dark/15 focus:border-foreground/50 dark:focus:border-foreground-dark/50 outline-none px-3 py-2 rounded-lg transition-colors placeholder:text-foreground/30 dark:placeholder:text-foreground-dark/30"
						/>
					</div>
					<div>
						<label
							for="field-linkedin"
							class="block font-meta text-sm mb-1.5 text-foreground/60 dark:text-foreground-dark/60"
							>LinkedIn</label
						>
						<input
							type="url"
							id="field-linkedin"
							name="linkedin"
							placeholder="https://linkedin.com/in/..."
							class="w-full bg-transparent border border-foreground/15 dark:border-foreground-dark/15 focus:border-foreground/50 dark:focus:border-foreground-dark/50 outline-none px-3 py-2 rounded-lg transition-colors placeholder:text-foreground/30 dark:placeholder:text-foreground-dark/30"
						/>
					</div>
					<div>
						<label
							for="field-website"
							class="block font-meta text-sm mb-1.5 text-foreground/60 dark:text-foreground-dark/60"
							>Website</label
						>
						<input
							type="url"
							id="field-website"
							name="website-url"
							placeholder="https://..."
							class="w-full bg-transparent border border-foreground/15 dark:border-foreground-dark/15 focus:border-foreground/50 dark:focus:border-foreground-dark/50 outline-none px-3 py-2 rounded-lg transition-colors placeholder:text-foreground/30 dark:placeholder:text-foreground-dark/30"
						/>
					</div>
				</div>

				<div id="track-section">
					<label
						for="field-track"
						class="block font-meta text-sm mb-1.5 text-foreground/60 dark:text-foreground-dark/60"
					>
						Track <span class="text-red-500">*</span>
					</label>
					<select
						id="field-track"
						name="track"
						required
						class="w-full bg-transparent border border-foreground/15 dark:border-foreground-dark/15 focus:border-foreground/50 dark:focus:border-foreground-dark/50 outline-none px-3 py-2 rounded-lg transition-colors"
					>
						<option value="">Select a track...</option>
						{
							TRACKS.map(function (t) {
								return <option value={t.slug}>{t.label}</option>
							})
						}
					</select>
				</div>

				<div id="title-section">
					<label
						for="field-title"
						class="block font-meta text-sm mb-1.5 text-foreground/60 dark:text-foreground-dark/60"
					>
						Post title <span class="text-red-500" id="title-required-star"
							>*</span
						>
						<span
							id="title-optional-note"
							class="text-foreground/30 dark:text-foreground-dark/30 hidden"
							>(optional)</span
						>
					</label>
					<input
						type="text"
						id="field-title"
						name="title"
						required
						class="w-full bg-transparent border border-foreground/15 dark:border-foreground-dark/15 focus:border-foreground/50 dark:focus:border-foreground-dark/50 outline-none px-3 py-2 rounded-lg transition-colors"
					/>
				</div>

				<div>
					<label
						for="field-content"
						class="block font-meta text-sm mb-1.5 text-foreground/60 dark:text-foreground-dark/60"
					>
						<span id="content-label">Blog content</span>
						<span class="text-red-500">*</span>
					</label>
					<textarea
						id="field-content"
						name="content"
						required
						rows="16"
						placeholder="Write your post here. Markdown is welcome, e.g.

# Here is my heading
## Here is my subheading

Some body text with **bold** and *italic*.

Plain text is fine too."
						class="w-full bg-transparent border border-foreground/15 dark:border-foreground-dark/15 focus:border-foreground/50 dark:focus:border-foreground-dark/50 outline-none px-3 py-2 rounded-lg transition-colors resize-y placeholder:text-foreground/30 dark:placeholder:text-foreground-dark/30"
					></textarea>
				</div>

				<div id="images-section">
					<label
						for="field-images"
						class="block font-meta text-sm mb-1.5 text-foreground/60 dark:text-foreground-dark/60"
					>
						Images <span class="text-foreground/30 dark:text-foreground-dark/30"
							>(up to 3, max 5 MB each)</span
						>
					</label>
					<input
						type="file"
						id="field-images"
						name="images"
						accept="image/jpeg,image/png,image/gif,image/webp"
						multiple
						class="w-full font-meta text-sm file:mr-3 file:px-3 file:py-1.5 file:rounded-lg file:border file:border-foreground/15 dark:file:border-foreground-dark/15 file:bg-transparent file:text-foreground dark:file:text-foreground-dark file:cursor-pointer cursor-pointer"
					/>
				</div>

				<div>
					<button type="submit" class="btn-pixel btn-pixel-red">Contribute</button>
				</div>

				<div
					id="submit-status"
					class="font-meta text-sm"
					role="status"
					aria-live="polite"
				>
				</div>
			</form>
		</div>
	</section>
</BaseLayout>

<script is:inline define:vars={{ authorNames }}>
	;(function () {
		var form = document.getElementById('submit-form')
		var status = document.getElementById('submit-status')
		var btn = form.querySelector('button[type="submit"]')
		if (!form || !status || !btn) return

		var nameInput = document.getElementById('field-name')
		var emailInput = document.getElementById('field-email')
		var emailStar = document.getElementById('email-required-star')
		var emailNote = document.getElementById('email-optional-note')
		var avatarInput = document.getElementById('field-avatar')
		var avatarGrid = document.getElementById('avatar-grid')
		var avatarText = document.getElementById('avatar-selection-text')
		var trackSelect = document.getElementById('field-track')
		var profileSection = document.getElementById('profile-section')

		var existingNames = authorNames.map(function (n) {
			return n.toLowerCase()
		})

		// Show profile section when avatar selected + new name entered
		function updateProfileSection() {
			var hasAvatar = avatarInput.value !== ''
			var name = nameInput.value.trim().toLowerCase()
			var isNew =
				name !== '' &&
				name !== 'anonymous' &&
				existingNames.indexOf(name) === -1
			profileSection.classList.toggle('hidden', !(hasAvatar && isNew))
		}

		// Anonymous toggle — make email optional when name is "Anonymous"
		function updateAnonymous() {
			var isAnon = nameInput.value.trim().toLowerCase() === 'anonymous'
			emailInput.required = !isAnon
			emailStar.classList.toggle('hidden', isAnon)
			emailNote.classList.toggle('hidden', !isAnon)
		}
		nameInput.addEventListener('input', function () {
			updateAnonymous()
			updateProfileSection()
		})
		nameInput.addEventListener('change', function () {
			updateAnonymous()
			updateProfileSection()
		})

		// Avatar grid selection
		avatarGrid.addEventListener('click', function (e) {
			var button = e.target.closest('.avatar-option')
			if (!button) return
			var id = button.dataset.avatar

			// Deselect if clicking the already-selected avatar
			var prev = avatarGrid.querySelector('.avatar-option.selected')
			if (prev === button) {
				prev.classList.remove(
					'selected',
					'border-primary',
					'dark:border-primary-dark'
				)
				prev.classList.add('border-transparent')
				avatarInput.value = ''
				avatarText.textContent = 'No avatar selected'
				updateProfileSection()
				return
			}

			// Deselect previous
			if (prev) {
				prev.classList.remove(
					'selected',
					'border-primary',
					'dark:border-primary-dark'
				)
				prev.classList.add('border-transparent')
			}

			// Select new
			button.classList.add(
				'selected',
				'border-primary',
				'dark:border-primary-dark'
			)
			button.classList.remove('border-transparent')
			avatarInput.value = id
			avatarText.textContent = 'Selected: ' + id
			updateProfileSection()
		})

		// Reset avatar state when form resets
		form.addEventListener('reset', function () {
			setTimeout(function () {
				var sel = avatarGrid.querySelector('.avatar-option.selected')
				if (sel) {
					sel.classList.remove(
						'selected',
						'border-primary',
						'dark:border-primary-dark'
					)
					sel.classList.add('border-transparent')
				}
				avatarInput.value = ''
				avatarText.textContent = 'No avatar selected'
				updateAnonymous()
			}, 0)
		})

		form.addEventListener('submit', function (e) {
			e.preventDefault()

			if (!trackSelect.value) {
				status.textContent = 'Please select a track for your blog post.'
				status.className = 'font-meta text-sm text-red-600 dark:text-red-400'
				return
			}

			var fileInput = form.querySelector('input[name="images"]')
			var files = fileInput ? Array.from(fileInput.files) : []

			if (files.length > 3) {
				status.textContent = 'Maximum 3 images allowed.'
				status.className = 'font-meta text-sm text-red-600 dark:text-red-400'
				return
			}
			for (var i = 0; i < files.length; i++) {
				if (files[i].size > 5 * 1024 * 1024) {
					status.textContent = 'Each image must be under 5 MB.'
					status.className = 'font-meta text-sm text-red-600 dark:text-red-400'
					return
				}
			}

			btn.disabled = true
			btn.textContent = 'Submitting...'
			btn.style.opacity = '0.5'
			status.textContent = ''
			status.className = 'font-meta text-sm'

			var data = new FormData(form)

			// Read images as base64 so we can send JSON (bypasses Vercel CSRF protection)
			var imagePromises = files.map(function (file) {
				return new Promise(function (resolve, reject) {
					var reader = new FileReader()
					reader.onload = function (ev) {
						resolve({ name: file.name, type: file.type, data: ev.target.result.split(',')[1] })
					}
					reader.onerror = reject
					reader.readAsDataURL(file)
				})
			})

			Promise.all(imagePromises)
				.then(function (images) {
					var payload = {
						name: data.get('name') || '',
						email: data.get('email') || '',
						track: trackSelect.value,
						title: data.get('title') || '',
						content: data.get('content') || '',
						avatar: data.get('avatar') || '',
						bio: data.get('bio') || '',
						linkedin: data.get('linkedin') || '',
						'website-url': data.get('website-url') || '',
						website: data.get('website') || '',
						subscribe: !!(form.querySelector('#field-subscribe') && form.querySelector('#field-subscribe').checked),
						images: images
					}
					return fetch('/api/submit', {
						method: 'POST',
						body: JSON.stringify(payload),
						headers: { 'content-type': 'application/json' }
					})
				})
				.then(function (r) {
					return r.json()
						.then(function (j) { return { ok: r.ok, body: j } })
						.catch(function () { return { ok: false, body: { ok: false, error: 'Server error (' + r.status + '). Please try again or email us directly.' } } })
				})
				.then(function (res) {
					if (res.ok && res.body.ok) {
						form.reset()
						status.textContent = 'Submitted! We\u2019ll be in touch.'
						status.className = 'font-meta text-sm text-green-700 dark:text-green-400'
					} else {
						status.textContent = res.body.error || 'Something went wrong. Please try again.'
						status.className = 'font-meta text-sm text-red-600 dark:text-red-400'
					}
				})
				.catch(function () {
					status.textContent = 'Network error. Please try again.'
					status.className = 'font-meta text-sm text-red-600 dark:text-red-400'
				})
				.finally(function () {
					btn.disabled = false
					btn.textContent = 'Contribute'
					btn.style.opacity = ''
				})
		})
	})()
</script>
