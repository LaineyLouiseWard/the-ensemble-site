---
import BaseLayout from '../layouts/BaseLayout.astro'
import { TRACKS } from '../consts'
---

<BaseLayout title="Submit a Post" description="Submit an article to The Ensemble Edit.">
	<main class="app-container pt-36">
		<h1 class="text-6xl pb-2 font-bold">Submit a Post</h1>
	</main>
	<section class="app-container py-12 mb-8">
		<div class="max-w-2xl">
			<p class="text-lg mb-8 text-foreground/70 dark:text-foreground-dark/70">
				Fill in the form below and your post will be reviewed and formatted by the editorial team.
				Want more control via GitHub? See the <a href="/blog/instructions-for-authors/" class="underline underline-offset-4 hover:text-primary dark:hover:text-primary-dark transition-colors">instructions for authors</a>.
			</p>

			<form id="submit-form" class="space-y-6">
				<!-- Honeypot -->
				<div style="position:absolute;left:-9999px;opacity:0;height:0;overflow:hidden;" aria-hidden="true">
					<input type="text" name="website" autocomplete="off" tabindex="-1" />
				</div>

				<div>
					<label for="field-name" class="block font-meta text-sm mb-1.5 text-foreground/60 dark:text-foreground-dark/60">
						Your name <span class="text-red-500">*</span>
					</label>
					<input
						type="text"
						id="field-name"
						name="name"
						required
						class="w-full bg-transparent border border-foreground/15 dark:border-foreground-dark/15 focus:border-foreground/50 dark:focus:border-foreground-dark/50 outline-none px-3 py-2 rounded-lg transition-colors"
					/>
				</div>

				<div>
					<label for="field-email" class="block font-meta text-sm mb-1.5 text-foreground/60 dark:text-foreground-dark/60">
						Email <span class="text-foreground/30 dark:text-foreground-dark/30">(optional, for follow-up)</span>
					</label>
					<input
						type="email"
						id="field-email"
						name="email"
						class="w-full bg-transparent border border-foreground/15 dark:border-foreground-dark/15 focus:border-foreground/50 dark:focus:border-foreground-dark/50 outline-none px-3 py-2 rounded-lg transition-colors"
					/>
				</div>

				<div>
					<label for="field-track" class="block font-meta text-sm mb-1.5 text-foreground/60 dark:text-foreground-dark/60">
						Track <span class="text-red-500">*</span>
					</label>
					<select
						id="field-track"
						name="track"
						required
						class="w-full bg-transparent border border-foreground/15 dark:border-foreground-dark/15 focus:border-foreground/50 dark:focus:border-foreground-dark/50 outline-none px-3 py-2 rounded-lg transition-colors"
					>
						<option value="">Select a track...</option>
						{TRACKS.map(function (t) {
							return <option value={t.slug}>{t.label}</option>
						})}
					</select>
				</div>

				<div>
					<label for="field-title" class="block font-meta text-sm mb-1.5 text-foreground/60 dark:text-foreground-dark/60">
						Post title <span class="text-red-500">*</span>
					</label>
					<input
						type="text"
						id="field-title"
						name="title"
						required
						class="w-full bg-transparent border border-foreground/15 dark:border-foreground-dark/15 focus:border-foreground/50 dark:focus:border-foreground-dark/50 outline-none px-3 py-2 rounded-lg transition-colors"
					/>
				</div>

				<div>
					<label for="field-content" class="block font-meta text-sm mb-1.5 text-foreground/60 dark:text-foreground-dark/60">
						Post content <span class="text-red-500">*</span>
					</label>
					<textarea
						id="field-content"
						name="content"
						required
						rows="16"
						placeholder="Write your post here. Markdown is welcome but plain text is fine too."
						class="w-full bg-transparent border border-foreground/15 dark:border-foreground-dark/15 focus:border-foreground/50 dark:focus:border-foreground-dark/50 outline-none px-3 py-2 rounded-lg transition-colors resize-y placeholder:text-foreground/30 dark:placeholder:text-foreground-dark/30"
					></textarea>
				</div>

				<div>
					<label for="field-images" class="block font-meta text-sm mb-1.5 text-foreground/60 dark:text-foreground-dark/60">
						Images <span class="text-foreground/30 dark:text-foreground-dark/30">(up to 3, max 5 MB each)</span>
					</label>
					<input
						type="file"
						id="field-images"
						name="images"
						accept="image/jpeg,image/png,image/gif,image/webp"
						multiple
						class="w-full font-meta text-sm file:mr-3 file:px-3 file:py-1.5 file:rounded-lg file:border file:border-foreground/15 dark:file:border-foreground-dark/15 file:bg-transparent file:text-foreground dark:file:text-foreground-dark file:cursor-pointer cursor-pointer"
					/>
				</div>

				<div>
					<button type="submit" class="btn-primary">Submit</button>
				</div>

				<div id="submit-status" class="font-meta text-sm" role="status" aria-live="polite"></div>
			</form>
		</div>
	</section>
</BaseLayout>

<script is:inline>
(function () {
	var form = document.getElementById('submit-form')
	var status = document.getElementById('submit-status')
	var btn = form.querySelector('button[type="submit"]')
	if (!form || !status || !btn) return

	form.addEventListener('submit', function (e) {
		e.preventDefault()

		var fileInput = form.querySelector('input[name="images"]')
		var files = fileInput.files

		if (files.length > 3) {
			status.textContent = 'Maximum 3 images allowed.'
			status.className = 'font-meta text-sm text-red-600 dark:text-red-400'
			return
		}
		for (var i = 0; i < files.length; i++) {
			if (files[i].size > 5 * 1024 * 1024) {
				status.textContent = 'Each image must be under 5 MB.'
				status.className = 'font-meta text-sm text-red-600 dark:text-red-400'
				return
			}
		}

		btn.disabled = true
		btn.textContent = 'Submitting...'
		btn.style.opacity = '0.5'
		status.textContent = ''
		status.className = 'font-meta text-sm'

		var data = new FormData(form)

		fetch('/api/submit', { method: 'POST', body: data })
			.then(function (r) {
				return r.json().then(function (j) { return { ok: r.ok, body: j } })
			})
			.then(function (res) {
				if (res.ok && res.body.ok) {
					form.reset()
					status.textContent = 'Submitted! We\u2019ll be in touch.'
					status.className = 'font-meta text-sm text-green-700 dark:text-green-400'
				} else {
					status.textContent = res.body.error || 'Something went wrong. Please try again.'
					status.className = 'font-meta text-sm text-red-600 dark:text-red-400'
				}
			})
			.catch(function () {
				status.textContent = 'Network error. Please try again.'
				status.className = 'font-meta text-sm text-red-600 dark:text-red-400'
			})
			.finally(function () {
				btn.disabled = false
				btn.textContent = 'Submit'
				btn.style.opacity = ''
			})
	})
})()
</script>
