---
import { getCollection } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import BlogCard from '../../components/BlogCard.astro'
import { TRACKS } from '../../consts'

export function getStaticPaths() {
	return TRACKS.map((track) => ({
		params: { track: track.slug },
		props: { label: track.label },
	}))
}

const { track } = Astro.params
const { label } = Astro.props

const posts = (await getCollection('blog'))
	.filter((post) => post.data.track === track)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())

const tagCounts = new Map<string, number>()
posts.forEach((p) => (p.data.tags || []).forEach((t) => tagCounts.set(t, (tagCounts.get(t) || 0) + 1)))
const trackTags = [...tagCounts.entries()].filter(([, c]) => c >= 2).sort(([a], [b]) => a.localeCompare(b)).map(([t]) => t)
---

<BaseLayout title={label} description={`Articles in the ${label} track.`}>
	<main class="app-container pt-24">
		<h1 class="text-6xl font-bold">{label}</h1>
		<p class="md:w-2/3 text-lg leading-[2rem] mt-4">Showing all posts in {label}.</p>
	</main>

	{trackTags.length > 0 && (
		<nav class="app-container pt-5">
			<div class="flex flex-wrap gap-2">
				{trackTags.map((tag) => (
					<a
						href={`/tags/${tag.toLowerCase().replace(/\s+/g, '-')}/`}
						class="tag-pill font-meta text-xs px-2.5 py-1 rounded-full border border-foreground/15 dark:border-foreground-dark/15 text-foreground/60 dark:text-foreground-dark/60 hover:border-foreground/30 dark:hover:border-foreground-dark/30 hover:text-foreground/80 dark:hover:text-foreground-dark/80 transition-colors"
					>
						#{tag}
					</a>
				))}
			</div>
		</nav>
	)}

	<!-- Posts -->
	<section class="app-container pt-6 pb-16">
		{
			posts.length > 0 ? (
				<div class="grid grid-cols-1 gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
					{posts.map((post) => (
						<BlogCard post={post} />
					))}
				</div>
			) : (
				<p class="text-lg opacity-50">No posts in this track yet.</p>
			)
		}
	</section>
</BaseLayout>
